{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "waqar-coffee-demo",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "waqar-coffee-db",
      "database_id": "41875335-f675-40bf-9881-70d2b211d7e8",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "FILES",
      "id": "d68a49e11cdf4cefb3d8d0a956a96ad9"
    }
  ]
}
